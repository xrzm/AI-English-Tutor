APP_NAME=教育服务系统
APP_VERSION=2.0.0
APP_ENV=production
ENABLE_DOCS=false
DEBUG=false
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8001
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-random-string
DATABASE_URL=postgresql://english_user:your_password@127.0.0.1:5432/english_db
DASHSCOPE_API_KEY=sk-your-api-key
QWEN_CHAT_MODEL=qwen-plus
QWEN_OCR_MODEL=qwen-vl-plus
QWEN_AUDIO_MODEL=qwen-audio-turbo
QWEN_TTS_MODEL=sambert-zhichu-v1
FFMPEG_PATH=/usr/bin/ffmpeg
MAX_UPLOAD_MB=20
ALLOW_ORIGINS=https://edu.xrzmblog.cn,http://localhost:3000
